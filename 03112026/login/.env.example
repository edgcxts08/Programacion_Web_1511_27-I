; Note: This file is for example purposes only. Copy this file to .env and fill in the values for your environment.
APP_NAME= "MyApp"
; Database configuration
DB_HOST= "127.0.0.1"
; Port number for the database connection
DB_PORT= "3306"
; Database name, username, and password for the database connection
DB_DATABASE= "myapp_db"
DB_USERNAME= "root"
DB_PASSWORD= "password"
